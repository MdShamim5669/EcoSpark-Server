# Server Configuration (PRD Section 15)
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/ecospark"

# Authentication & Security (PRD Section 10 & 15)
JWT_SECRET="your_jwt_secret"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

# Client & Server URL (PRD Section 15)
CLIENT_URL="http://localhost:3000"
SERVER_URL="http://localhost:5000"

# Payment Gateway Configuration (SSLCommerz / ShurjoPay / Stripe - PRD Section 15)
STORE_ID="your_store_id"
STORE_PASSWORD="your_store_password"
SSL_IS_LIVE=false
PAYMENT_GATEWAY_URL=""

# Stripe Configuration (PRD Architecture Section 2)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudinary Image Storage (PRD Section 15)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Seed Admin Credentials (PRD Section 2 & 15)
ADMIN_EMAIL="admin@ecospark.com"
ADMIN_PASSWORD="admin123"

# Google Gemini AI / RAG Configuration
GEMINI_API_KEY=""
